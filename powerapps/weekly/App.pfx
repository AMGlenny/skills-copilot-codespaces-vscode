// =====================================================================
// PMS Weekly: app-level formulas
// Paste each block into the property named in its heading (select App
// in the tree view, then pick the property from the property list).
// =====================================================================


// ---------------------------------------------------------------------
// App.Formulas
// ---------------------------------------------------------------------
// Colours. Every text colour below passes WCAG 2.2 AA (4.5:1) on white,
// and white text passes on clrHeader and clrAccent.
clrHeader = ColorValue("#26384A");
clrAccent = ColorValue("#1F5AA6");
clrAccentDark = ColorValue("#163F75");
clrText = ColorValue("#1B1B1B");
clrMuted = ColorValue("#545454");
clrBorder = ColorValue("#767676");
clrPage = ColorValue("#F3F4F6");
clrPanel = Color.White;
clrError = ColorValue("#B00020");
clrSuccess = ColorValue("#1E6B34");

// Who is using the app. Emails are stored in lower case.
fxMe = Lower(User().Email);
fxPerson = LookUp(people, email = fxMe);
fxCanEdit = !IsBlank(fxPerson) && fxPerson.active && fxPerson.app_role.Value <> "viewer";
fxEditMode = If(fxCanEdit, DisplayMode.Edit, DisplayMode.View);
fxIsNarrow = App.Width < 900;
fxHasReports = !IsEmpty(Filter(people, line_manager_email = fxMe && active = true));

// Display labels for stored codes.
fxPriorityLabels = Table(
    {code: "must", label: "Must do"},
    {code: "should", label: "Should do"},
    {code: "could", label: "Could do"}
);
fxWorkloadLabels = Table(
    {code: "light", label: "Light"},
    {code: "manageable", label: "Manageable"},
    {code: "heavy", label: "Heavy"},
    {code: "overloaded", label: "Overloaded"}
);
fxWellbeingLabels = Table(
    {code: "thriving", label: "Thriving"},
    {code: "ok", label: "OK"},
    {code: "struggling", label: "Struggling"}
);
fxLevelLabels = Table(
    {code: "low", label: "Low"},
    {code: "medium", label: "Medium"},
    {code: "high", label: "High"}
);


// ---------------------------------------------------------------------
// App.OnStart
// ---------------------------------------------------------------------
// Monday of the current week.
Set(varWeek, DateAdd(Today(), -(Weekday(Today(), StartOfWeek.Monday) - 1), TimeUnit.Days));
Set(varTeam, fxPerson.org_unit_key);
Set(varLoaded, false);

// Teams, shown with their full path, e.g. "Jobs › Supply Delivery › Team A".
ClearCollect(colOrgUnits, Filter(org_units, active = true));
ClearCollect(
    colTeams,
    SortByColumns(
        ForAll(
            colOrgUnits As u,
            With(
                {p: LookUp(colOrgUnits, org_unit_key = u.parent_key)},
                With(
                    {g: LookUp(colOrgUnits, org_unit_key = p.parent_key)},
                    {
                        org_unit_key: u.org_unit_key,
                        path: Concat(Filter(Table({v: g.unit_name}, {v: p.unit_name}, {v: u.unit_name}), !IsBlank(v)), v, " › ")
                    }
                )
            )
        ),
        "path", SortOrder.Ascending
    )
);

ClearCollect(colPeople, Filter(people, active = true));

// Everything a task or problem can contribute to: groups and active measures.
ClearCollect(
    colContrib,
    ForAll(Filter(groups, active = true), {type: "group", key: group_key, label: group_name & " (" & group_type.Value & ")"}),
    ForAll(Filter(measures, status.Value = "active"), {type: "measure", key: measure_code, label: source_ref & " " & measure_name & " (measure)"})
);
// Pending task ticks, saved with "Save my week". Defined with one dummy row so
// the collection has a shape, then emptied.
ClearCollect(colTaskTicks, {code: "", done: false});
Clear(colTaskTicks);
