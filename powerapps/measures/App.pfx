// =====================================================================
// PMS Measures: app-level formulas
// Paste each block into the App property named in its heading.
// =====================================================================


// ---------------------------------------------------------------------
// App.Formulas
// ---------------------------------------------------------------------
clrHeader = ColorValue("#26384A");
clrAccent = ColorValue("#1F5AA6");
clrAccentDark = ColorValue("#163F75");
clrText = ColorValue("#1B1B1B");
clrMuted = ColorValue("#545454");
clrBorder = ColorValue("#767676");
clrPage = ColorValue("#F3F4F6");
clrPanel = Color.White;
clrError = ColorValue("#B00020");
clrSuccess = ColorValue("#1E6B34");
// RAG colours are always shown with words, never on their own.
clrGreen = ColorValue("#1E6B34");
clrAmber = ColorValue("#8A5300");
clrRed = ColorValue("#B00020");

fxMe = Lower(User().Email);
fxPerson = LookUp(people, email = fxMe);
fxIsAdmin = fxPerson.app_role.Value = "admin" && fxPerson.active;
fxIsNarrow = App.Width < 900;

fxQualityLabels = Table(
    {code: "verified", label: "Verified: checked against source"},
    {code: "provisional", label: "Provisional: may change"},
    {code: "estimated", label: "Estimated: modelled or partial"},
    {code: "unverified", label: "Unverified: not yet checked"}
);
fxRagLabels = Table(
    {code: "green", label: "Green: on or better than target"},
    {code: "amber", label: "Amber: short of target, within tolerance"},
    {code: "red", label: "Red: off track"},
    {code: "no_target", label: "No target set"},
    {code: "no_data", label: "No data"},
    {code: "not_applicable", label: "RAG not used for this measure"}
);
fxStatusLabels = Table(
    {code: "not_started", label: "Not started"},
    {code: "draft", label: "Draft"},
    {code: "submitted", label: "Awaiting review"},
    {code: "returned", label: "Returned for changes"},
    {code: "approved", label: "Approved"}
);


// ---------------------------------------------------------------------
// App.StartScreen
// ---------------------------------------------------------------------
// Email links open straight onto a value: ...?submission=PM-0002|M-2026-08
If(IsBlank(Param("submission")), scrMeasHome, scrMeasSubmission)


// ---------------------------------------------------------------------
// App.OnStart
// ---------------------------------------------------------------------
Set(varSubKey, Param("submission"));
Set(varTab, "update");
ClearCollect(colMyRoles, Filter(measure_roles, email = fxMe && active = true));
ClearCollect(colMeasures, Filter(measures, status.Value = "active"));
ClearCollect(colPeople, Filter(people, active = true));
